      "delete_workflow_instance": false,
      "description": "This workflow takes input as a testID (which can be parsed from a webhook generated by ThousandEyes as $.event.testId) and queries the API to get the path visualization data for the test. It obtains the most current path visualization info, and a snapshot from 15m prior. This information is useful during ThousandEyes alerts for network congestion, as it contains the routed Layer 3 path of devices.",
      "display_name": "Get ThousandEyes path info",
      "runtime_user": {
        "target_default": true
      },
      "target": {
        "no_target": true
      }
    },
