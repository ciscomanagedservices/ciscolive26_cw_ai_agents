    "actions": [
      {
        "unique_name": "definition_activity_02S0B1F5ABH855A2bwvXYRfJSLbXmruieTh",
        "name": "Execute Python Script",
        "title": "Normalize Commands input",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Execute Python Script",
          "display_name": "Normalize Commands input",
          "script": "import sys\nimport json\nimport ast\n\n# 1. Get Input\ntry:\n    raw_input = sys.argv[1].strip()\nexcept IndexError:\n    raw_input = \"\"\n\nnormalized_commands = None\n\n# --- Logic Waterfall ---\n\n# Step 1: Try JSON Parsing\n# Handles: [\"show clock\", \"show ip\"]  -\u003e List\n# Handles: \"show clock\"               -\u003e String\ntry:\n    normalized_commands = json.loads(raw_input)\nexcept json.JSONDecodeError:\n    pass\n\n# Step 2: Try Python Literal Evaluation (if Step 1 failed)\n# Handles: \"show clock\", \"show ip\" (tuple syntax) -\u003e List\n# Handles: ['show clock', 'show ip'] (single quotes) -\u003e List\nif normalized_commands is None:\n    try:\n        evaluated = ast.literal_eval(raw_input)\n        if isinstance(evaluated, (list, tuple)):\n            normalized_commands = list(evaluated)\n    except (ValueError, SyntaxError):\n        pass\n\n# Step 3: Comma Separation Fallback (if Step 1 \u0026 2 failed)\n# Handles: show clock, show ip int brief (raw text list) -\u003e List\nif normalized_commands is None:\n    if ',' in raw_input:\n        # Split by comma and clean up whitespace\n        items = [item.strip() for item in raw_input.split(',')]\n        \n        # Remove surrounding quotes if user wrapped individual items in them \n        # (e.g. \"cmd1\", \"cmd2\" that somehow failed previous checks)\n        cleaned_items = []\n        for i in items:\n            if (i.startswith('\"') and i.endswith('\"')) or (i.startswith(\"'\") and i.endswith(\"'\")):\n                cleaned_items.append(i[1:-1])\n            else:\n                cleaned_items.append(i)\n        normalized_commands = cleaned_items\n    \n    else:\n        # Step 4: Single Raw String Fallback\n        # Handles: show clock (no quotes, no commas) -\u003e String\n        \n        # If the input still has surrounding quotes but failed JSON (rare), strip them\n        if len(raw_input) \u003e= 2 and (\n            (raw_input.startswith('\"') and raw_input.endswith('\"')) or \n            (raw_input.startswith(\"'\") and raw_input.endswith(\"'\"))\n        ):\n            normalized_commands = raw_input[1:-1]\n        else:\n            normalized_commands = raw_input\n\n# --- Output ---\nnormalized_commands = json.dumps(normalized_commands)",
          "script_arguments": [
            "$workflow.definition_workflow_02RHRA78FVXF647oUKIzjqbWCnK075YJPXL.input.variable_workflow_02RHRBTX0EL1N7DTWBvnwll2bBc1v5TaI1H$"
          ],
          "script_queries": [
            {
              "script_query": "normalized_commands",
              "script_query_name": "normalized_commands",
              "script_query_type": "string"
            }
          ],
          "skip_execution": false
        },
