      {
        "unique_name": "definition_activity_02RHR6DHU5SMD6W8RStMV6PxX55a5rjrNkU",
        "name": "Execute Python Script",
        "title": "Parse SSE Response",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Execute Python Script",
          "display_name": "Parse SSE Response",
          "script": "\"\"\"\nParse MCP tool call SSE response\n\"\"\"\n\nimport sys\nimport json\n\n# 1. Get Input\ntry:\n    raw_response = sys.argv[1]\nexcept IndexError:\n    print(json.dumps({\"error\": \"No input provided\"}), file=sys.stdout)\n    sys.exit(1)\n\n# 2. Extract JSON from SSE format (remove \"event: message\\ndata: \" prefix)\nlines = raw_response.strip().split('\\n')\njson_data = None\n\nfor line in lines:\n    if line.startswith('data: '):\n        json_data = line[6:]  # Remove \"data: \" prefix\n        break\n\n# Fallback: If no \"data:\" prefix found, try parsing the whole string (robustness)\nif not json_data:\n    json_data = raw_response\n\n# 3. Parse and Extract Result\ntry:\n    response = json.loads(json_data)\n    result_block = response.get(\"result\", {})\n    l_tool_result = {}\n\n    # PATH A: Success (Structured Content Exists)\n    if \"structuredContent\" in result_block and \"result\" in result_block[\"structuredContent\"]:\n        l_tool_result = result_block[\"structuredContent\"][\"result\"]\n\n    # PATH B: Error/Validation (Content List Exists)\n    elif \"content\" in result_block and isinstance(result_block[\"content\"], list):\n        # Extract text from all items where type is 'text'\n        error_messages = [\n            item.get(\"text\", \"\") \n            for item in result_block[\"content\"] \n            if item.get(\"type\") == \"text\"\n        ]\n        \n        # Join into one string\n        full_message = \"\\n\".join(error_messages)\n        \n        # Create a standardized error object\n        l_tool_result = {\n            \"error\": full_message,\n            \"status\": \"FAILED\" \n        }\n\n    else:\n        # PATH C: Unknown Format\n        l_tool_result = {\n            \"error\": \"Unknown response format\",\n            \"raw_result\": result_block\n        }\n\nexcept json.JSONDecodeError:\n    l_tool_result = {\"error\": \"Invalid JSON input\"}\nexcept Exception as e:\n    l_tool_result = {\"error\": f\"Script processing error: {str(e)}\"}\n\n# 4. Output Result as JSON string\nprint(json.dumps(l_tool_result))",
          "script_arguments": [
            "$activity.definition_activity_02RHQTNZ6NEZV1obgCIyPuQ38KMVojAqfvt.output.response_body$"
          ],
          "script_queries": [
            {
              "script_query": "l_tool_result",
              "script_query_name": "l_tool_result",
              "script_query_type": "string"
            }
          ],
          "skip_execution": false
        },
