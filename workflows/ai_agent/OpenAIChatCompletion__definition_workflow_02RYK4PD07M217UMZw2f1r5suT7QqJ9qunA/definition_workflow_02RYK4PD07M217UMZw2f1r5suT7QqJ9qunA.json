                    "actions": [
                      {
                        "unique_name": "definition_activity_02RYK4PRDWU1T02OF1cjpQddYLe3XrnVpP5",
                        "name": "Set Variables",
                        "title": "Exit Retry Loop (Set Retries to -1)",
                        "type": "core.set_multiple_variables",
                        "base_type": "activity",
                        "properties": {
                          "continue_on_failure": false,
                          "description": "Sets retry counter to -1 to exit the while loop after successful API call",
                          "display_name": "Exit Retry Loop (Set Retries to -1)",
                          "skip_execution": false,
                          "variables_to_update": [
                            {
                              "variable_to_update": "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJY80T7a0y3kUQ71feb2XaUPwzfz$",
