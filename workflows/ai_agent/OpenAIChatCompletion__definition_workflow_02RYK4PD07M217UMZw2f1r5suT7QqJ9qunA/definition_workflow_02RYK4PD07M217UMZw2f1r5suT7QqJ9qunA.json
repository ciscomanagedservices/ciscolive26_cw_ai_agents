    "object_type": "definition_workflow",
    "actions": [
      {
        "unique_name": "definition_activity_02RYK4PGV80O86m6WJkzllR7TtBcDaUEADT",
        "name": "Execute Python Script",
        "title": "Build API Request Body and Path",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Constructs the HTTP request body and URL path for OpenAI API. Handles differences between OpenAI and Azure OpenAI formats. Includes workaround for known multi_tool_use.parallel issue.",
          "display_name": "Build API Request Body and Path",
          "script": "\"\"\"Build OpenAI Chat Completion API Request\n\nConstructs request body and URL path for OpenAI or Azure OpenAI API.\nHandles platform-specific differences and applies necessary workarounds.\n\"\"\"\nimport sys\nimport json\n\ndef parse_json_arg(arg, default=None):\n    \"\"\"Safely parse JSON argument with fallback.\"\"\"\n    if not arg or str(arg).strip() == '':\n        return default\n    try:\n        return json.loads(arg)\n    except json.JSONDecodeError as e:\n        # Print error to stderr so it shows in workflow logs without breaking stdout JSON flow\n        print(f\"Error parsing JSON argument: {e}. Input: {arg[:50]}...\", file=sys.stderr)\n        sys.exit(1)\n\n# --- 1. Validate Argument Count ---\n# We expect 8 arguments (script name + 7 inputs)\nif len(sys.argv) \u003c 8:\n    print(f\"Error: Expected 7 arguments, got {len(sys.argv)-1}\", file=sys.stderr)\n    sys.exit(1)\n\n# --- 2. Parse \u0026 Sanitize Arguments ---\nmodel_id = sys.argv[1].strip()\napi_version = sys.argv[2].strip()\nis_azure = sys.argv[3].strip().lower() == 'true'\nreasoning_effort_input = sys.argv[4].strip() # Treat as string, not float\ntools = parse_json_arg(sys.argv[5], default=[])\nresponse_format = parse_json_arg(sys.argv[6], default=None)\nmessages = parse_json_arg(sys.argv[7], default=[])\n\n# --- 3. Build Base Request Body ---\nbody = {\n    \"stream\": False,\n    \"messages\": messages\n}\n\n# --- 4. Handle Reasoning Effort ---\n# Only include if it matches valid API values.\n# This prevents errors if an old \"temperature\" float (e.g. \"0.7\") is accidentally passed.\nvalid_efforts = {'none', 'minimal', 'low', 'medium', 'high', 'xhigh'}\nif reasoning_effort_input.lower() in valid_efforts:\n    body[\"reasoning_effort\"] = reasoning_effort_input.lower()\n\n# --- 5. Add Optional Parameters ---\nif tools and len(tools) \u003e 0:\n    body[\"tools\"] = tools\n\nif response_format:\n    body[\"response_format\"] = response_format\n\n# --- 6. Platform-Specific Configuration ---\nif is_azure:\n    # Azure: Model is in the URL path\n    completions_path = f'/openai/deployments/{model_id}/chat/completions?api-version={api_version}'\nelse:\n    # Standard OpenAI: Model is in the JSON body\n    completions_path = '/chat/completions'\n    body[\"model\"] = model_id\n\n# --- 7. Serialize \u0026 Output ---\njson_body = json.dumps(body, ensure_ascii=False)\n\n# Workaround: fixes GitHub issue microsoft/semantic-kernel#4447\njson_body = json_body.replace('multi_tool_use.parallel', 'parallel')\n\nprint(completions_path)\nprint(json_body)",
          "script_arguments": [
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJYS8A1YfxYmFeWS2IRleDCM86kt$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDK0OD34jdu89VguKfTF4tUUeh5hb$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJX2J75BvCXcHZkqhuBjOvCzUCwN$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDK17IL2Ho1qI6nuQ7zhGfr2cA7Qi$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJXMVD2Awx5zuvKWe4OKFawsNWJi$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJZOMD0SPeMD0tIijg06QiYG96JT$",
            "$workflow.definition_workflow_02RYK4PD07M217UMZw2f1r5suT7QqJ9qunA.input.variable_workflow_02RYK4PDJZZO90oQReDSqSOsL2uxCAu3x7p$"
          ],
          "script_queries": [
            {
              "script_query": "json_body",
              "script_query_name": "json_body",
              "script_query_type": "string"
            },
            {
              "script_query": "completions_path",
              "script_query_name": "completions_path",
              "script_query_type": "string"
            }
          ],
          "skip_execution": false
        },
        "object_type": "definition_activity"
      },
